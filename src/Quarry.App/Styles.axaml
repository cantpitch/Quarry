<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Button.toolbar">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.toolbar PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="PathIcon.node">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style Selector="TextBlock.status">
        <Setter Property="Foreground" Value="{DynamicResource StatusText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector="DataGrid.results">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="RowHeight" Value="22" />
    </Style>
    <Style Selector="DataGrid.results DataGridCell">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="DataGrid.results DataGridColumnHeader">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="DataGrid.results DataGridRowHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource StatusText}" />
    </Style>
</Styles>
