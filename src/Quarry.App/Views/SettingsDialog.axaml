<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Quarry.App.ViewModels"
        x:Class="Quarry.App.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" CanResize="False">
    <StackPanel Margin="20" Spacing="16">
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Classes="label" Text="Editor font size" />
            <NumericUpDown Grid.Column="1" Minimum="8" Maximum="40" Increment="1" FormatString="0" Value="{Binding FontSize}" />

            <TextBlock Grid.Row="1" Classes="label" Text="Max rows per result set" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100000000" Increment="10000" FormatString="0"
                           Value="{Binding MaxRows}" ToolTip.Tip="0 keeps every row" />

            <TextBlock Grid.Row="2" Classes="label" Text="Command timeout (seconds)" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="86400" Increment="30" FormatString="0"
                           Value="{Binding CommandTimeout}" ToolTip.Tip="0 waits indefinitely" />

            <TextBlock Grid.Row="3" Classes="label" Text="Default output" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding OutputModes}" SelectedItem="{Binding DefaultOutputMode}" />

            <TextBlock Grid.Row="4" Classes="label" Text="Batch separator" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BatchSeparator}" Width="120" HorizontalAlignment="Left" />

            <CheckBox Grid.Row="5" Grid.Column="1" Content="Stop running batches after an error" IsChecked="{Binding StopOnError}" />
        </Grid>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
